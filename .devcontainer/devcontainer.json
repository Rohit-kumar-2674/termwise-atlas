{
  "name": "Termwise Atlas docs",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install -r requirements-docs.lock",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Documentation preview", "onAutoForward": "notify"}},
  "customizations": {"vscode": {"settings": {"files.trimTrailingWhitespace": false}}}
}
